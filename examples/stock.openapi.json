{
  "openapi": "3.0.3",
  "info": {
    "title": "在庫照会",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "summary": "在庫一覧を取得",
        "responses": {
          "200": {
            "description": "在庫一覧"
          }
        }
      }
    },
    "/items/{sku}": {
      "get": {
        "summary": "商品コードで在庫を取得",
        "parameters": [
          {
            "in": "path",
            "name": "sku",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "TS-01"
          }
        ],
        "responses": {
          "200": {
            "description": "該当商品の在庫"
          },
          "404": {
            "description": "商品が見つかりません"
          }
        }
      }
    }
  }
}
