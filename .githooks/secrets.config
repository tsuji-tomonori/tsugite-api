[secrets]
    patterns = (A3T[A-Z0-9]|AKIA|ASIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ANSA)[A-Z0-9]{16}
    patterns = "(AWS|Aws|aws)?_?(SECRET|Secret|secret)_?(ACCESS|Access|access)?_?(KEY|Key|key)[\"']?[[:space:]]*(:|=>|=)[[:space:]]*[\"']?[A-Za-z0-9/+=]{40}"
    patterns = gh[pousr]_[a-zA-Z0-9]{36,}
    patterns = github_pat_[a-zA-Z0-9_]{22,}
    patterns = BEGIN (RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY
