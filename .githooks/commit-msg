#!/bin/sh
set -eu
.githooks/scan-secrets "$1"

subject=$(awk '/[^[:space:]]/ { print; exit }' "$1") || exit 1
types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

if printf '%s\n' "$subject" | grep -Eq "^($types)(\([^()[:space:]]+\))?!?: [^[:space:]]"; then
    exit 0
fi

cat >&2 <<'EOF'
コミットメッセージの1行目を Conventional Commits 形式で書いてください。
形式: type(scope)!: 変更内容（scope と ! は省略可）
例: feat(api): API一覧に検索を追加
使用できる type: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
EOF
exit 1
