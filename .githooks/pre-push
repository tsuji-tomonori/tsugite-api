#!/bin/sh
set -eu

while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$remote_ref" = refs/heads/main ] || continue
    if [ "$local_ref" = "(delete)" ]; then
        echo 'main の削除を中止しました。' >&2
        exit 1
    fi
    # リモートにまだ main がない場合は履歴の書き換えが発生しない。
    case "$remote_oid" in *[!0]*) ;; *) continue ;; esac
    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
        echo 'main の履歴を保持できません。対象リモートを fetch し、先端を取り込んでください。' >&2
        exit 1
    fi
done
