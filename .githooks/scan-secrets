#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
export PATH="$root/tools/vendor/git-secrets:$PATH"
export GIT_LITERAL_PATHSPECS=1
config="$root/.githooks/secrets.config"
if [[ ! -x "$root/tools/vendor/git-secrets/git-secrets" || ! -r "$config" ]]; then
    echo 'git-secrets または検査ルールを読み込めないため、コミットを中止しました。' >&2
    exit 1
fi

if (( $# )); then
    if git -c "include.path=$config" secrets --scan -- "$1" >/dev/null 2>&1; then
        exit 0
    fi
else
    # NUL 区切りで部分ステージ・リネーム・特殊文字を含むパスを扱う。
    if git diff --cached --name-only --diff-filter=ACMRT -z -- |
        xargs -0 sh -c '
            config=$1
            shift
            [ "$#" -eq 0 ] || git -c "include.path=$config" secrets --scan --cached -- "$@"
        ' sh "$config" >/dev/null 2>&1; then
        exit 0
    fi
fi
echo '機密情報を検出したか、git-secrets の検査に失敗しました。コミット対象を確認してください。' >&2
exit 1
